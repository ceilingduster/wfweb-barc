BARC_GATEWAY=wss://remote.barc.ca
# Identity and credential are generated automatically and saved privately.
# Optional human-friendly name; otherwise the node hostname is used.
# BARC_NODE_NAME=Club Raspberry Pi
# Only set BOTH of these when using a manually pre-provisioned node:
# BARC_NODE_ID=rpi-01
# BARC_NODE_TOKEN=REPLACE_WITH_UNIQUE_NODE_TOKEN
# Paste the complete public certificate from this Pi's wfweb server.crt.
# Compose accepts quoted multiline values. Never paste the private key.
BARC_RADIO_CA='-----BEGIN CERTIFICATE-----
PASTE_THE_CERTIFICATE_CONTENTS_HERE
-----END CERTIFICATE-----'
# Optional overrides only if wfweb uses a different local address/port:
# BARC_WFWEB_URL=https://localhost:8080/
# BARC_RADIO_WS=wss://localhost:8080
