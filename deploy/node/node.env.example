BARC_GATEWAY=wss://remote.barc.ca
BARC_NODE_ID=rpi-01
BARC_NODE_TOKEN=REPLACE_WITH_UNIQUE_NODE_TOKEN
# For a native wfweb install, use wss://localhost:8080 and its trusted cert.
BARC_RADIO_WS=wss://localhost:8080
BARC_RADIO_CA=/etc/wfweb-barc/server.crt

# Local HTTP(S) wfweb frontend; requests are carried inside the outbound tunnel.
BARC_WFWEB_URL=https://localhost:8080/
